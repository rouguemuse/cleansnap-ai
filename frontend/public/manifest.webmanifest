{
  "id": "/",
  "name": "CleanSnap Studio — Commercial Image Polish & Vector Cutline Lab",
  "short_name": "CleanSnap Studio",
  "description": "100% On-Device AI Subject Cutout, Manual Edge Refinement, 5 Studio Environments & Die-Cut Vector .SVG Export.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#07080c",
  "theme_color": "#07080c",
  "lang": "en-US",
  "dir": "ltr",
  "categories": [
    "photo",
    "graphics",
    "design",
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/icons/store-desktop-1440.png",
      "sizes": "1440x1180",
      "type": "image/png",
      "form_factor": "wide",
      "label": "CleanSnap Studio Desktop Workspace — 4-Step Guided Cutout, 5 Environments & Split Comparison"
    },
    {
      "src": "/icons/store-mobile-390.png",
      "sizes": "390x920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "CleanSnap Studio Mobile Workspace — On-Device Batch Cutout & Vector .SVG Export"
    }
  ],
  "shortcuts": [
    {
      "name": "Studio Cleaner & 5 Backdrops",
      "short_name": "Studio Cleaner",
      "description": "Batch remove backgrounds and composite across 5 studio backdrops",
      "url": "/?tab=cleaner",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Vector .SVG Export Vault",
      "short_name": "Export Vault",
      "description": "Export transparent .PNG cutouts and Marching-Squares vector .SVG packs",
      "url": "/?tab=vault",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "/?source=file-handler",
      "accept": {
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
